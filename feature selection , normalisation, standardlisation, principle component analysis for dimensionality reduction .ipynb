import pandas as pd
import numpy as np
from sklearn.preprocessing import MinMaxScaler, StandardScaler
from sklearn.decomposition import PCA
import matplotlib.pyplot as plt

# 1. Load dataset
df = pd.read_csv('Colleges_Dataset.csv')

print("Original Dataset:")
print(df.head())

# 2. Select numerical features
features = df[['Academic', 'Accommodation', 'Faculty', 'Placement']].copy()

# 3. Convert features into numeric values
features = features.apply(pd.to_numeric, errors='coerce')

# 4. Check missing values
print("\nMissing Values:")
print(features.isnull().sum())

# Replace infinity values
features = features.replace([np.inf, -np.inf], np.nan)

# 5. Handle missing values
features = features.fillna(features.median())

print("\nMissing values after cleaning:")
print(features.isnull().sum())


# 6. Min-Max Normalization
minmax = MinMaxScaler()
normalized = minmax.fit_transform(features)

normalized_df = pd.DataFrame(
    normalized,
    columns=features.columns
)

print("\nNormalized Data:")
print(normalized_df.head())

print("\nNormalized range:",
      normalized.min(), "to", normalized.max())


# 7. VISUALIZATION OF NORMALIZATION

# Boxplot
plt.figure(figsize=(10, 5))

normalized_df.boxplot()

plt.title("Normalization using Min-Max Scaling")
plt.ylabel("Normalized Values")
plt.xlabel("Features")
plt.grid(True)
plt.show()


# Histogram
normalized_df.hist(figsize=(10, 7), bins=10)

plt.suptitle("Distribution of Normalized Data")
plt.tight_layout()
plt.show()


# 8. Z-score Standardization
scaler = StandardScaler()
standardized = scaler.fit_transform(features)

standardized_df = pd.DataFrame(
    standardized,
    columns=features.columns
)

print("\nStandardized Data:")
print(standardized_df.head())

print("\nStandardized mean:",
      standardized.mean().round(4))

print("Standardized standard deviation:",
      standardized.std().round(4))


# 9. VISUALIZATION OF STANDARDIZATION

# Boxplot
plt.figure(figsize=(10, 5))

standardized_df.boxplot()

plt.title("Standardization using Z-score")
plt.ylabel("Standardized Values")
plt.xlabel("Features")
plt.grid(True)
plt.show()


# Histogram
standardized_df.hist(figsize=(10, 7), bins=10)

plt.suptitle("Distribution of Standardized Data")
plt.tight_layout()
plt.show()


# 10. COMPARISON OF ORIGINAL, NORMALIZED AND STANDARDIZED DATA

fig, axes = plt.subplots(1, 3, figsize=(16, 5))

features.boxplot(ax=axes[0])
axes[0].set_title("Original Data")

normalized_df.boxplot(ax=axes[1])
axes[1].set_title("Normalized Data")

standardized_df.boxplot(ax=axes[2])
axes[2].set_title("Standardized Data")

plt.tight_layout()
plt.show()


# 11. PCA: Reduce 4 features to 2 components
pca = PCA(n_components=2)

principal_components = pca.fit_transform(standardized)

print("\nPCA Reduced Data:")
print(principal_components)

print("\nExplained variance ratio:",
      pca.explained_variance_ratio_)

print("Total variance captured:",
      pca.explained_variance_ratio_.sum() * 100, "%")


# 12. PCA Visualization

pass_fail_status = features['Academic'].map(
    lambda x: 'Pass' if x >= 8.0 else 'Fail'
)

colors = pass_fail_status.map({
    'Pass': 'green',
    'Fail': 'red'
})

plt.figure(figsize=(8, 6))

plt.scatter(
    principal_components[:, 0],
    principal_components[:, 1],
    c=colors,
    alpha=0.7
)

plt.xlabel('PC1')
plt.ylabel('PC2')
plt.title('PCA: 4 Features Reduced to 2')

plt.legend(handles=[
    plt.Line2D([], [], marker='o', color='w',
               markerfacecolor='green',
               label='Pass (Academic >= 8.0)'),

    plt.Line2D([], [], marker='o', color='w',
               markerfacecolor='red',
               label='Fail (Academic < 8.0)')
])

plt.grid(True)
plt.show()


# 13. PCA Explained Variance Visualization

plt.figure(figsize=(7, 5))

plt.bar(
    ['PC1', 'PC2'],
    pca.explained_variance_ratio_
)

plt.xlabel('Principal Components')
plt.ylabel('Explained Variance Ratio')
plt.title('PCA Explained Variance')

plt.show()


# 14. Final Dataset Comparison

print("\nOriginal Dataset Shape:", features.shape)
print("Normalized Dataset Shape:", normalized_df.shape)
print("Standardized Dataset Shape:", standardized_df.shape)
print("PCA Reduced Dataset Shape:", principal_components.shape)

print("\nLab completed successfully!")
